# ===============================================
# Agent Watchers & Personal AI Hub - Environment
# ===============================================

# User Identity
GITHUB_USER=your_github_username
USER_NAME=Your Name

# LLM Provider Configuration
# Supported providers: openai_compatible (Ollama, Gateway, vLLM, OpenRouter, Groq), anthropic
LLM_PROVIDER=openai_compatible
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here

# Models by capability
FAST_MODEL=gpt-4o-mini
REASONING_MODEL=gpt-4o

# Task Tracker Provider (options: shortcut, jira, github_issues)
TASK_TRACKER_PROVIDER=shortcut
TASK_TRACKER_TOKEN=your_tracker_api_token
TASK_TRACKER_BASE=https://api.app.shortcut.com/api/v3

# Slack Watcher Channels (optional)
SLACK_CHANNEL_1=C0123456789
SLACK_CHANNEL_2=C9876543210
