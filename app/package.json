{
  "name": "locum-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-server/index.ts",
    "review": "tsx src/cli.ts review",
    "typecheck": "tsc --noEmit",
    "build:main": "node scripts/build-main.mjs",
    "start": "npm run build:main && electron dist/main.cjs",
    "smoke": "npm run build:main && electron dist/main.cjs --smoke"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/mcp": "^1.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@ai-sdk/openai-compatible": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^6.0.0",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.44.0",
    "octokit": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "electron": "^40.10.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true,
    "electron@40.10.6": true
  },
  "main": "dist/main.cjs"
}
