# Identidade. Os dois valem para a linha de comando; na interface o token mora no
# keychain e o dono sai do cadastro do gatilho, e os dois vencem o que estiver aqui.
GITHUB_TOKEN=
GITHUB_OWNER=
MACHINE_ID=minha-maquina

# Provedores por chave de API (o runtime claude-code nao usa nenhuma destas)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Provedores compativeis com OpenAI. Outro gateway se cadastra pela interface.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OLLAMA_BASE_URL=http://localhost:11434/v1

# Caminho do banco. Vazio usa ~/Library/Application Support/locum
LOCUM_HOME=
