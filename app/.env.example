# Identidade
GITHUB_TOKEN=
GITHUB_OWNER=
MACHINE_ID=minha-maquina

# Provedores por chave de API (o runtime claude-code nao usa nenhuma destas)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Provedor compativel com OpenAI (GLM, Gateway, OpenRouter, Ollama)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GATEWAY_API_KEY=
GATEWAY_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Caminho do banco. Vazio usa ~/Library/Application Support/agent-watchers
AGENT_WATCHERS_HOME=
